#!/bin/sh

version="2.1.2"
tskdir="${TSK_DIR:-$HOME/.tsk}"
editor="${EDITOR:-vi}"
tmpdir="${TMPDIR:-/tmp}"
ext="tsk.md"

# Shared first-line parser. User text is passed through stdin or ENVIRON, never
# through awk -v, which interprets backslash escapes.
header_awk='
    function parse_header(line, fields,n,i,t) {
        header_title=""; header_count=0; header_invalid_count=0
        n=split(line,fields,/[[:space:]]+/)
        for(i=1;i<=n;i++) {
            t=fields[i]; if(t=="")continue
            if(t ~ /^\+[A-Za-z0-9_-]+(:[A-Za-z0-9_-]+)?$/) {
                header_tags[++header_count]=substr(t,2)
            } else {
                if(t ~ /^\+/)header_invalid[++header_invalid_count]=t
                header_title=header_title (header_title=="" ? "" : " ") t
            }
        }
    }
'

usage() {
    s=$(basename "$0")
    cat <<EOF_USAGE
$s $version - tiny task manager

usage:
    $s                         show what needs attention
    $s r [FILTERS...]          review a filtered/piped task selection
    $s a TITLE [TAGS...]       add a task
    $s l [OPTIONS] [FILTERS]   list tasks
    $s s FILTERS...            cat task file(s) unchanged
    $s e [FILTERS...]          edit one task (latest when omitted)
    $s done FILTERS...         complete tasks
    $s open FILTERS...         reopen tasks
    $s due DATE FILTERS...     set a deadline; DATE '-' removes it
    $s t CHANGES...            change tags on tasks piped on stdin
    $s d FILTERS...            delete tasks
    $s dir                     print the current task directory
    $s h                       show help

list options:
    --all                      include completed tasks
    --done                     show only completed tasks

filters (applied sequentially):
    +foo                       exact tag
    -+foo                      exclude exact tag
    text                       case-insensitive literal text
    -text                      exclude literal text
    ~REGEX                     case-insensitive regular expression
    -~REGEX                    exclude regular expression
    ID                         full or displayed short task id

examples:
    $s a Fix VPN DNS +work +next
    $s l +work
    $s l +work -+done
    $s l '~vpn|dns'
    $s done A8fQ
    $s l +work | $s t +next
    $s l +work | $s t -+next

Tasks are Markdown files in ${TSK_DIR:-$HOME/.tsk}. The first line is the title
followed by +tags. Only +done, +next and +due:YYYY-MM-DD have built-in meaning.
Everything else is just a tag.
EOF_USAGE
}

helpmsg() {
    usage
    cat <<EOF_HELP

daily view:
    Running '$s' with no arguments shows overdue tasks, tasks due today,
    tomorrow, within the next 7 days, and +next tasks. Due tasks outside
    TODAY/TOMORROW include a compact relative day count such as '(3d)' or
    '(2d late)'. Completed tasks are hidden.

review:
    '$s r [filters...]' renders the same view for a subset. It can consume a
    task list on stdin, so these are equivalent building blocks:

        $s r +work
        $s l +work | $s r
        $s l +work | $s r +qilab

files:
    One task is one Markdown file. The filename is the stable task id; normal
    output shows a short unique id. The full id is always accepted.

tags:
    +done                      completed
    +next                      current working set
    +due:YYYY-MM-DD            real deadline

    All other tags are plain user-defined tags.

pipes:
    '$s l' output can be piped into commands that modify tasks:

        $s l +work | $s r
        $s l +work | $s done
        $s l vpn   | $s t +next
        $s l vpn   | $s t -+next
        $s l +home | $s due tomorrow

    In '$s t', '+foo' adds a tag and '-+foo' removes it.

extensions:
    Unknown commands are resolved as external '$s-COMMAND' executables.
    For example, installing '$s-fzf' enables '$s fzf'.

diagnostics:
    $s check                    validate task files

environment:
    TSK_DIR                     task directory [default: \$HOME/.tsk]
    EDITOR                      editor [default: vi]
EOF_HELP
}

_die()  { printf '%s: error: %s\n' "$scriptname" "$1" >&2; exit 1; }
_warn() { printf '%s: warn: %s\n'  "$scriptname" "$1" >&2; }
_info() { printf '%s: %s\n'        "$scriptname" "$1" >&2; }

_today() { date '+%Y-%m-%d'; }
_now() { date '+%Y%m%d%H%M%S%3N'; }
_normalize_date() { date -d "$1" '+%Y-%m-%d' 2>/dev/null; }

_stdin_available() { [ -p /dev/stdin ] || [ -f /dev/stdin ]; }
_ensure_dir() { mkdir -p "$tskdir" || _die "cannot create task directory [$tskdir]"; }
_task_path() { printf '%s/%s.%s\n' "$tskdir" "$1" "$ext"; }
_valid_tag() { printf '%s\n' "$1" | grep -Eq '^[A-Za-z0-9_-]+(:[A-Za-z0-9_-]+)?$'; }

# flock on the directory inode survives atomic task replacement and leaves no
# lock file to accidentally commit. All CLI writers, editors and tsk-y use it.
_write_lock() {
    [ -d "$tskdir" ] || return 0
    exec 9<"$tskdir" || _die "cannot open task directory [$tskdir]"
    flock -x 9 || _die "cannot lock task directory [$tskdir]"
}

_no_tasks() {
    [ -d "$tskdir" ] || return 0
    for f in "$tskdir"/*."$ext"; do
        [ -f "$f" ] && return 1
    done
    return 0
}

_tmp() {
    kind=${1:-tmp}
    mktemp "$tmpdir/tsk.$kind.XXXXXX" || _die "cannot create temporary file"
}

_rand4() {
    while :; do
        out=$(dd if=/dev/urandom bs=64 count=1 2>/dev/null | LC_ALL=C tr -dc 'A-Za-z0-9' | cut -c1-4)
        [ "${#out}" -eq 4 ] && { printf '%s\n' "$out"; return; }
    done
}

_create_id() {
    while :; do
        suffix=$(_rand4)
        set -- "$tskdir"/*-"$suffix"."$ext"
        [ -e "$1" ] && continue
        id="$(_now)-$suffix"
        [ ! -e "$tskdir/$id.$ext" ] && { printf '%s\n' "$id"; return; }
    done
}

# Snapshot columns: full-id, short-id, title, done, due, comma-separated-tags.
# A short id is the last '-' component when unique; otherwise the full id is used.
_build_snapshot() {
    [ -d "$tskdir" ] || return 0
    set --
    for f in "$tskdir"/*."$ext"; do
        [ ! -f "$f" ] || set -- "$@" "$f"
    done
    [ "$#" -gt 0 ] || return 0
    awk -v ext="$ext" "$header_awk"'
        FNR != 1 { next }
        {
            id=FILENAME; sub(/^.*\//,"",id); sub("\\." ext "$","",id)
            parse_header($0)
            tags=""; done=0; due=""
            for (i=1; i<=header_count; i++) {
                tag=header_tags[i]
                tags=tags (tags=="" ? "" : ",") tag
                if (tag=="done") done=1
                if (substr(tag,1,4)=="due:" && due=="") due=substr(tag,5)
            }
            sid=id; sub(/^.*-/,"",sid)
            order[++n]=id; short[id]=sid; count[sid]++
            titles[id]=header_title; dones[id]=done; dues[id]=due; alltags[id]=tags
        }
        END {
            for (i=1; i<=n; i++) {
                id=order[i]; sid=count[short[id]]==1 ? short[id] : id
                printf "%s\t%s\t%s\t%d\t%s\t%s\n", id,sid,titles[id],dones[id],dues[id],alltags[id]
            }
        }
    ' "$@"
}

_snapshot() {
    snapshot=$(_tmp snapshot) || _die "cannot create task snapshot"
    _build_snapshot >"$snapshot" || { rm -f "$snapshot"; _die "cannot build task snapshot"; }
}

_prepare_selection() {
    _snapshot
    selected=''
    trap 'rm -f "$snapshot" "$selected"' 0
    trap 'exit 1' 1 2 3 15
    selected=$(_tmp selected) || _die "cannot create task selection"
}

# Convert list output, a full id, or a displayed short id from stdin to full ids.
_ids_from_stdin() (
    snapshot=$1
    awk -F '\t' '
        FILENAME==ARGV[1] { full[$1]=$1; short[$2]=$1; next }
        {
            line=$0
            sub(/^[[:space:]]+/,"",line); sub(/[[:space:]]+$/, "",line)
            if (line=="") next
            token=line
            if (substr(line,1,1)=="[") {
                p=index(line,"]"); if (p>2) token=substr(line,2,p-2)
            } else if ((p=index(line,":"))>1) token=substr(line,1,p-1)
            else { split(line,a,/[[:space:]]+/); token=a[1] }
            id=(token in full) ? full[token] : ((token in short) ? short[token] : "")
            if (id!="" && !seen[id]++) print id
        }
    ' "$snapshot" -
)

# Apply one filter to a file containing full task ids.
_filter() (
    snapshot=$1 input=$2 filter=$3 output=$4
    invert=0 pattern=$filter
    case "$pattern" in -?*) invert=1; pattern=${pattern#-} ;; esac
    [ -n "$pattern" ] || { cat "$input" >"$output"; return; }

    case "$pattern" in
        +*)
            tag=${pattern#+}
            _valid_tag "$tag" || _die "invalid exact tag filter [$pattern]"
            awk -F '\t' -v want="$tag" -v inv="$invert" '
                FILENAME==ARGV[1] { tags[$1]=$6; next }
                { found=index("," tags[$1] ",", "," want ",")>0; if ((!inv&&found)||(inv&&!found)) print $1 }
            ' "$snapshot" "$input" >"$output"
            ;;
        ~*)
            regex=${pattern#\~}
            [ -n "$regex" ] || _die "empty regex filter"
            TSK_FILTER="$regex" awk -F '\t' -v inv="$invert" '
                BEGIN { re=tolower(ENVIRON["TSK_FILTER"]); valid=("" ~ re) }
                FILENAME==ARGV[1] { text[$1]=tolower($1 " " $2 " " $3 " " $6); next }
                { found=text[$1] ~ re; if ((!inv&&found)||(inv&&!found)) print $1 }
            ' "$snapshot" "$input" >"$output" || _die "invalid regex [$regex]"
            ;;
        *)
            exact=$(TSK_FILTER="$pattern" awk -F '\t' 'BEGIN { p=ENVIRON["TSK_FILTER"] } $1==p || $2==p { print $1; exit }' "$snapshot") || return 1
            if [ -n "$exact" ]; then
                awk -v want="$exact" -v inv="$invert" '{ found=($1==want); if ((!inv&&found)||(inv&&!found)) print $1 }' "$input" >"$output"
            else
                TSK_FILTER="$pattern" awk -F '\t' -v inv="$invert" '
                    BEGIN { p=tolower(ENVIRON["TSK_FILTER"]) }
                    FILENAME==ARGV[1] { text[$1]=tolower($1 " " $2 " " $3 " " $6); next }
                    { found=index(text[$1],p)>0; if ((!inv&&found)||(inv&&!found)) print $1 }
                ' "$snapshot" "$input" >"$output"
            fi
            ;;
    esac
)

# Build a full-id selection from stdin (when piped) or all tasks, then apply filters.
_select() (
    snapshot=$1 output=$2
    shift 2
    cur=$(_tmp sel) || return 1
    next=''
    trap 'rm -f "$cur" "$next"' 0
    trap 'exit 1' 1 2 3 15
    next=$(_tmp sel) || return 1
    if _stdin_available; then
        _ids_from_stdin "$snapshot" >"$cur" || return 1
    else
        cut -f1 "$snapshot" >"$cur" || return 1
    fi
    for filter in "$@"; do
        _filter "$snapshot" "$cur" "$filter" "$next" || return 1
        mv "$next" "$cur" || { rm -f "$cur" "$next"; _die "cannot update task selection"; }
        next=$(_tmp sel) || return 1
    done
    cat "$cur" >"$output"
)

_require_tasks() { [ -s "$1" ] || _die "no task found"; }
_count() { awk 'END { print NR+0 }' "$1"; }

_render() (
    snapshot=$1 ids=$2 mode=${3:-all}
    awk -F '\t' -v mode="$mode" '
        FILENAME==ARGV[1] { sid[$1]=$2; title[$1]=$3; done[$1]=$4; tags[$1]=$6; next }
        {
            id=$1
            if (mode=="open" && done[id]) next
            if (mode=="done" && !done[id]) next
            printf "[%s] %s", sid[id], title[id]
            n=split(tags[id],a,",")
            for (i=1;i<=n;i++) if (a[i]!="") printf " +%s",a[i]
            print ""
        }
    ' "$snapshot" "$ids"
)

# Rewrite only the first line, keeping the body untouched. ACTION is add, remove,
# or replace-prefix. replace-prefix removes KEY:* and appends TAG.
_tag_update() (
    file=$1 action=$2 tag=$3 key=${4:-}
    [ -f "$file" ] && [ -r "$file" ] && [ -w "$file" ] && [ ! -L "$file" ] || _die "cannot update [$file]"
    tmp=$(mktemp "$tskdir/.tsk.edit.XXXXXX") || _die "cannot create task update"
    trap 'rm -f "$tmp"' 0
    trap 'exit 1' 1 2 3 15
    {
        awk -v action="$action" -v want="$tag" -v key="$key" "$header_awk"'
            NR==1 {
                parse_header($0)
                n=0; seen=0
                for (i=1;i<=header_count;i++) {
                    t=header_tags[i]
                    keep=1
                    if (action=="remove" && t==want) keep=0
                    if (action=="replace-prefix" && (t==key || index(t,key ":")==1)) keep=0
                    if (keep) { tags[++n]=t; if (t==want) seen=1 }
                }
                if (action=="add" && !seen) tags[++n]=want
                if (action=="replace-prefix" && want!="") tags[++n]=want
                printf "%s",header_title
                for (i=1;i<=n;i++) printf " +%s",tags[i]
                print ""
                exit
            }
        ' "$file" || exit 1
        tail -n +2 "$file" || exit 1
    } >"$tmp" || { rm -f "$tmp"; _die "cannot update [$file]"; }
    cp --attributes-only --preserve=mode,ownership -- "$file" "$tmp" || _die "cannot preserve permissions for [$file]"
    mv -fT "$tmp" "$file" || _die "cannot update [$file]"
    tmp=''
)

_review() (
    snapshot=$1 selected=$2
    today=$(_today)
    tomorrow=$(date -d tomorrow '+%Y-%m-%d') || _die "cannot calculate tomorrow"
    week=$(date -d '+7 days' '+%Y-%m-%d') || _die "cannot calculate one-week horizon"

    awk -F '\t' -v today="$today" -v tomorrow="$tomorrow" -v week="$week" '
        FILENAME==ARGV[1] { selected[$1]=1; next }
        !($1 in selected) { next }
        function has(tags,w) { return index("," tags ",", "," w ",")>0 }
        function extra(tags, a,n,i,t,out) {
            n=split(tags,a,","); out=""
            for(i=1;i<=n;i++) { t=a[i]; if(t==""||t=="done"||t=="next"||substr(t,1,4)=="due:") continue; out=out " +" t }
            return out
        }
        function daynum(s,a,y,m,d,era,yoe,mp,doy,doe) {
            split(s,a,"-"); y=a[1]+0; m=a[2]+0; d=a[3]+0; if(m<=2)y--
            era=int(y/400); yoe=y-era*400; mp=m+(m>2?-3:9)
            doy=int((153*mp+2)/5)+d-1; doe=yoe*365+int(yoe/4)-int(yoe/100)+doy
            return era*146097+doe
        }
        function rel(id,n) {
            if(due[id]==""||due[id]==today||due[id]==tomorrow)return ""
            n=daynum(due[id])-todayn
            return n < 0 ? sprintf(" (%dd late)", -n) : sprintf(" (%dd)", n)
        }
        function line(id,dated,mark,x) {
            x="  "; if(dated)x=x mark " " due[id] " "
            return x "[" sid[id] "]" rel(id) " " title[id] extra(tags[id])
        }
        function sortdue(a,n,i,j,k) {
            for(i=2;i<=n;i++){k=a[i];j=i-1;while(j>=1&&(due[a[j]]>due[k]||(due[a[j]]==due[k]&&a[j]>k))){a[j+1]=a[j];j--}a[j+1]=k}
        }
        BEGIN { todayn=daynum(today) }
        {
            id=$1; sid[id]=$2; title[id]=$3; done=$4+0; due[id]=$5; tags[id]=$6
            if(done)next
            open++
            if(due[id]!=""&&due[id]<today) overdue[++on]=id
            else if(due[id]==today) td[++dn]=id
            else if(due[id]==tomorrow) tm[++mn]=id
            else if(due[id]>tomorrow&&due[id]<=week) wk[++wn]=id
            else if(has(tags[id],"next")) nx[++nn]=id
        }
        END {
            if(!on&&!dn&&!mn&&!wn&&!nn){ if(open)printf "Nothing urgent. %d open task%s.\n",open,open==1?"":"s"; else print "Nothing to do."; exit }
            sortdue(overdue,on); sortdue(wk,wn)
            if(on){print "OVERDUE";for(i=1;i<=on;i++)print line(overdue[i],1,"!")}
            if(dn){if(on)print "";print "TODAY";for(i=1;i<=dn;i++)print line(td[i],1,"=")}
            if(mn){if(on||dn)print "";print "TOMORROW";for(i=1;i<=mn;i++)print line(tm[i],1,">")}
            if(wn){if(on||dn||mn)print "";print "IN A WEEK";for(i=1;i<=wn;i++)print line(wk[i],1,"-")}
            if(nn){if(on||dn||mn||wn)print "";print "NEXT";for(i=1;i<=nn;i++)print line(nx[i],0,"")}
        }
    ' "$selected" "$snapshot"
)

list_tasks() (
    _no_tasks && { _warn "no tasks in [$tskdir]"; return 1; }
    mode=open
    while [ "$#" -gt 0 ]; do
        case "$1" in --all) mode=all; shift ;; --done) mode='done'; shift ;; --) shift; break ;; *) break ;; esac
    done
    _prepare_selection
    _select "$snapshot" "$selected" "$@" || return 1
    _render "$snapshot" "$selected" "$mode"
)

daily_view() (
    _no_tasks && { printf 'Nothing to do.\n'; return; }
    _prepare_selection
    cut -f1 "$snapshot" >"$selected" || return 1
    _review "$snapshot" "$selected"
)

review_tasks() (
    _no_tasks && { printf 'Nothing to do.\n'; return; }
    _prepare_selection
    _select "$snapshot" "$selected" "$@" || return 1
    _review "$snapshot" "$selected"
)

add_task() (
    [ "$#" -gt 0 ] || _die "missing task title"
    parsed=$(TSK_HEADER="$*" awk "$header_awk"'
        BEGIN {
            line=ENVIRON["TSK_HEADER"]
            if(line ~ /[\r\n]/) { print "task title must be one line" > "/dev/stderr"; exit 1 }
            parse_header(line)
            if(header_title=="") { print "empty task title" > "/dev/stderr"; exit 1 }
            if(header_invalid_count) { print "invalid tag: " header_invalid[1] > "/dev/stderr"; exit 1 }
            printf "%s\t",header_title
            sep=""
            for(i=1;i<=header_count;i++) {
                tag=header_tags[i]
                if(!seen[tag]++) { printf "%s%s",sep,tag; sep=" " }
            }
            print ""
        }
    ') || _die "invalid task header"
    tab=$(printf '\t')
    title=${parsed%%"$tab"*}
    tags=${parsed#*"$tab"}
    due='' due_count=0
    for tag in $tags; do
        case "$tag" in
            due:*) due_count=$((due_count+1)); [ "$due_count" -eq 1 ] || _die "a task can have only one due date"; due=${tag#due:} ;;
        esac
    done

    if [ -n "$due" ]; then
        norm=$(_normalize_date "$due") || _die "invalid due date [$due]"
        clean=''
        for tag in $tags; do
            case "$tag" in due:*) ;; *) clean="$clean${clean:+ }$tag" ;; esac
        done
        tags="$clean${clean:+ }due:$norm"
    fi

    id=$(_create_id) || _die "cannot create task id"
    file=$(_task_path "$id")
    tmp=$(mktemp "$tskdir/.tsk.new.XXXXXX") || _die "cannot create task"
    trap 'rm -f "$tmp"' 0
    trap 'exit 1' 1 2 3 15
    {
        printf '%s' "$title" || exit 1
        for tag in $tags; do printf ' +%s' "$tag" || exit 1; done
        printf '\n' || exit 1
        if _stdin_available; then printf '\n' && cat || exit 1; fi
    } >"$tmp" || { rm -f "$tmp"; _die "cannot create task"; }
    mv "$tmp" "$file" || { rm -f "$tmp"; _die "cannot create task [$file]"; }
    tmp=''

    _snapshot
    short=$(awk -F '\t' -v id="$id" '$1==id {print $2}' "$snapshot") || { rm -f "$snapshot"; return 1; }
    rm -f "$snapshot"
    _info "created [$short] $title"
)

show_tasks() (
    _no_tasks && { _warn "no tasks in [$tskdir]"; return 1; }
    [ "$#" -gt 0 ] || _stdin_available || _die "specify a task"
    _prepare_selection
    _select "$snapshot" "$selected" "$@" || return 1
    _require_tasks "$selected"
    while IFS= read -r id; do cat "$(_task_path "$id")" || _die "cannot read task [$id]"; done <"$selected"
)

edit_task() (
    _no_tasks && { _warn "no tasks in [$tskdir]"; return 1; }
    _prepare_selection
    if ! _stdin_available && [ "$#" -eq 0 ]; then
        awk -F '\t' 'END { if(NR)print $1 }' "$snapshot" >"$selected" || return 1
        _require_tasks "$selected"
    else
        _select "$snapshot" "$selected" "$@" || return 1
        _require_tasks "$selected"
        n=$(_count "$selected")
        [ "$n" -eq 1 ] || _die "selection contains $n tasks; narrow it to one"
    fi
    IFS= read -r id <"$selected" || return 1
    file=$(_task_path "$id")
    if command -v "$editor" >/dev/null 2>&1; then
        set -- "$editor" "$file"
    else
        # EDITOR is a user-supplied shell command; the task path remains a
        # separate argument, including when it contains shell metacharacters.
        set -- sh -c 'exec '"$editor"' "$@"' "$scriptname-editor" "$file"
    fi
    if _stdin_available; then
        if ( : </dev/tty ) 2>/dev/null; then "$@" </dev/tty; else "$@" </dev/null; fi
    else
        "$@"
    fi
)

_select_change() {
    snapshot=$1 selected=$2
    shift 2
    if ! _stdin_available && [ "$#" -eq 0 ]; then _die "specify filters or pipe a task selection"; fi
    _select "$snapshot" "$selected" "$@" || return 1
    _require_tasks "$selected"
}

done_tasks() (
    _no_tasks && { _warn "no tasks in [$tskdir]"; return 1; }
    _prepare_selection
    _select_change "$snapshot" "$selected" "$@" || return 1
    while IFS= read -r id; do _tag_update "$(_task_path "$id")" add 'done' || return 1; done <"$selected"
    _info 'done'
)

open_tasks() (
    _no_tasks && { _warn "no tasks in [$tskdir]"; return 1; }
    _prepare_selection
    _select_change "$snapshot" "$selected" "$@" || return 1
    while IFS= read -r id; do _tag_update "$(_task_path "$id")" remove 'done' || return 1; done <"$selected"
    _info open
)

due_tasks() (
    [ "$#" -gt 0 ] || _die "usage: $scriptname due <date|-> [filters...]"
    value=$1; shift
    _no_tasks && { _warn "no tasks in [$tskdir]"; return 1; }
    _prepare_selection
    _select_change "$snapshot" "$selected" "$@" || return 1
    if [ "$value" = - ]; then
        while IFS= read -r id; do _tag_update "$(_task_path "$id")" replace-prefix '' due || return 1; done <"$selected"
        _info "due date removed"; return
    fi
    norm=$(_normalize_date "$value") || _die "invalid date [$value]"
    while IFS= read -r id; do _tag_update "$(_task_path "$id")" replace-prefix "due:$norm" due || return 1; done <"$selected"
    _info "due $norm"
)

tag_tasks() (
    [ "$#" -gt 0 ] || _die "specify tag changes"
    _stdin_available || _die "tag changes require tasks on stdin"
    _no_tasks && { _warn "no tasks in [$tskdir]"; return 1; }
    _prepare_selection
    changes=''
    trap 'rm -f "$snapshot" "$selected" "$changes"' 0
    changes=$(_tmp changes) || return 1
    _ids_from_stdin "$snapshot" >"$selected" || return 1
    _require_tasks "$selected"

    # Validate the entire request before modifying any task.
    for change in "$@"; do
        case "$change" in +*) op=add; tag=${change#+} ;; -+*) op=remove; tag=${change#-+} ;; *) _die "invalid tag change [$change]; use +tag or -+tag" ;; esac
        _valid_tag "$tag" || _die "invalid tag [$tag]"
        case "$op:$tag" in
            add:due:*)
                value=${tag#due:}; norm=$(_normalize_date "$value") || _die "invalid due date [$value]"
                printf 'replace-prefix\t%s\tdue\n' "due:$norm" >>"$changes" || return 1
                ;;
            *)
                printf '%s\t%s\t\n' "$op" "$tag" >>"$changes" || return 1
                ;;
        esac
    done
    tab=$(printf '\t')
    while IFS="$tab" read -r op tag key; do
        while IFS= read -r id; do
            _tag_update "$(_task_path "$id")" "$op" "$tag" "$key" || return 1
        done <"$selected"
    done <"$changes"
    _info "tags updated"
)

del_tasks() (
    _no_tasks && { _warn "no tasks in [$tskdir]"; return 1; }
    piped=0; _stdin_available && piped=1
    _prepare_selection
    _select_change "$snapshot" "$selected" "$@" || return 1
    _render "$snapshot" "$selected" || return 1
    if [ "$piped" -eq 0 ] && [ -t 0 ]; then
        printf 'delete %s task(s) (y/n)? ' "$(_count "$selected")"
        read -r answer; [ "$answer" = y ] || return 1
    fi
    while IFS= read -r id; do rm -f "$(_task_path "$id")" || _die "cannot delete [$id]"; done <"$selected"
    _info deleted
)

check_tasks() (
    set --
    for f in "$tskdir"/*."$ext"; do
        [ ! -f "$f" ] || set -- "$@" "$f"
    done
    [ "$#" -gt 0 ] || { printf 'ok: no problems found\n'; return; }
    awk "$header_awk"'
        function task_id(file) { sub(/^.*\//,"",file); sub(/\.tsk\.md$/,"",file); return file }
        function issue(message) { print message ": [" id "]"; issues++ }
        function valid_date(value, a,y,m,d,days) {
            if(value !~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)return 0
            split(value,a,"-"); y=a[1]+0; m=a[2]+0; d=a[3]+0
            if(m<1||m>12||d<1)return 0
            days=(m==2 ? 28+(y%4==0&&(y%100!=0||y%400==0)) : (m==4||m==6||m==9||m==11 ? 30 : 31))
            return d<=days
        }
        BEGIN {
            for(i=1;i<ARGC;i++) {
                file=ARGV[i]; id=task_id(file); expected[file]=1
                if(id !~ /^[A-Za-z0-9][A-Za-z0-9_-]*$/)issue("invalid task id")
            }
        }
        FNR==1 {
            id=task_id(FILENAME); visited[FILENAME]=1
            parse_header($0)
            if(header_title=="")issue("empty title")
            for(i=1;i<=header_invalid_count;i++)issue("invalid tag " header_invalid[i])
            for(tag in seen)delete seen[tag]
            dues=0
            for(i=1;i<=header_count;i++) {
                tag=header_tags[i]
                if(seen[tag]++==1)issue("duplicate tag +" tag)
                if(substr(tag,1,4)=="due:") {
                    dues++
                    if(!valid_date(substr(tag,5)))issue("invalid due date " substr(tag,5))
                }
            }
            if(dues>1)issue("multiple due dates")
        }
        /^(<<<<<<<+|>>>>>>>+|\|\|\|\|\|\|\|+)([[:space:]]|$)/ {
            if(!conflicts[FILENAME]++)issue("unresolved merge conflict")
        }
        END {
            for(file in expected)if(!(file in visited)) { id=task_id(file); issue("empty title") }
            if(issues) { print issues " problem(s) found" > "/dev/stderr"; exit 1 }
            print "ok: no problems found"
        }
    ' "$@"
)

main() {
    [ "$#" -gt 0 ] || { daily_view; return; }
    cmd=$1; shift
    case "$cmd" in
        a) _ensure_dir; _write_lock ;;
        e|done|open|due|t|d) _write_lock ;;
    esac
    case "$cmd" in
        r) review_tasks "$@" ;; a) add_task "$@" ;; l) list_tasks "$@" ;; s) show_tasks "$@" ;;
        e) edit_task "$@" ;; done) done_tasks "$@" ;; open) open_tasks "$@" ;; due) due_tasks "$@" ;;
        t) tag_tasks "$@" ;; d) del_tasks "$@" ;;
        dir) [ "$#" -eq 0 ] || _die "usage: $scriptname dir"; printf '%s\n' "$tskdir" ;;
        h|help|-h|--help) helpmsg ;; check) check_tasks "$@" ;;
        *)
            if command -v "$scriptname-$cmd" >/dev/null 2>&1; then "$scriptname-$cmd" "$@"
            else _die "unknown command [$cmd]; try '$scriptname h'"
            fi
            ;;
    esac
}

scriptname=$(basename "$0")
main "$@"
