#!/bin/sh

# Small interactive frontend for tsk. Keep it small on purpose: discovery and
# selection belong here; task semantics stay in tsk.

version="0.4.1"
prog=$(basename "$0")
fzf_cmd=${TSK_FZF_FZF:-fzf}
history_file=${TSK_FZF_HISTORY:-$HOME/.fzfhistory-tsk}
tmpdir=${TMPDIR:-/tmp}

usage() {
    cat <<EOF_USAGE
usage: $prog [options] [initial query]  [v$version]

options:
    -q, --query QUERY       initial fuzzy query
    -f, --filter FILTER     pre-filter with a tsk filter (repeatable)
    -h, --help              show help

+tag and -+tag arguments are automatically treated as tsk filters.
Other positional arguments form the initial fuzzy query.

keys:
    enter       print selected task(s) like tsk l
    tab         multi-select
    ctrl-e      edit current task
    ctrl-a      add a task from the current query
    ctrl-d      mark selected task(s) done
    alt-p       toggle preview
EOF_USAGE
}

err() { printf '%s: %s\n' "$prog" "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || err "command not found: $1"; }

list_tasks() {
    set --
    if [ -n "${TSK_FZF_FILTER_FILE:-}" ] && [ -f "$TSK_FZF_FILTER_FILE" ]; then
        while IFS= read -r filter || [ -n "$filter" ]; do
            set -- "$@" "$filter"
        done <"$TSK_FZF_FILTER_FILE"
    fi

    tsk l "$@" | awk '
        /^\[[^]]+\][[:space:]]/ {
            p = index($0, "] ")
            id = substr($0, 2, p - 2)
            text = substr($0, p + 2)
            printf "%s\t%s\n", id, text
        }
    '
}

pipe_ids() {
    [ "$#" -gt 0 ] || return 1
    printf '%s\n' "$@"
}

preview_task() {
    [ "$#" -eq 1 ] || return 0
    pipe_ids "$1" | tsk s 2>/dev/null
}

edit_id() {
    [ "$#" -eq 1 ] || return 0
    pipe_ids "$1" | tsk e
}

add_task() {
    initial=${1:-}
    [ -r /dev/tty ] || return 1
    if [ -n "$initial" ]; then
        printf 'new task [%s]: ' "$initial" >/dev/tty
    else
        printf 'new task: ' >/dev/tty
    fi
    IFS= read -r task </dev/tty || return 1
    [ -n "$task" ] || task=$initial
    [ -n "$task" ] || return 0

    # Deliberately split words without eval: this lets +tags entered in the
    # prompt remain tags while ordinary words become the title.
    set -f
    oldifs=$IFS
    IFS=' '
    set -- $task
    IFS=$oldifs
    tsk a "$@" || return 1
    tsk e
}

mark_done() {
    [ "$#" -gt 0 ] || return 0
    pipe_ids "$@" | tsk done
}

case "${1:-}" in
    __list) list_tasks; exit $? ;;
    __preview) shift; preview_task "$@"; exit $? ;;
    __edit) shift; edit_id "$@"; exit $? ;;
    __add) shift; add_task "$@"; exit $? ;;
    __done) shift; mark_done "$@"; exit $? ;;
esac

if [ "${1:-}" = -h ] || [ "${1:-}" = --help ]; then
    usage
    exit 0
fi

need tsk
need "$fzf_cmd"

filter_file=$(mktemp "$tmpdir/tsk-fzf.filters.XXXXXX") || err 'cannot create temporary file'
trap 'rm -f "$filter_file"' 0 1 2 3 15
: >"$filter_file"

query=''
append_query() {
    if [ -n "$query" ]; then query="$query $1"; else query=$1; fi
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        -q|--query)
            [ "$#" -ge 2 ] || err "$1 requires an argument"
            query=$2; shift 2
            ;;
        --query=*) query=${1#*=}; shift ;;
        -f|--filter)
            [ "$#" -ge 2 ] || err "$1 requires an argument"
            printf '%s\n' "$2" >>"$filter_file"; shift 2
            ;;
        --filter=*) printf '%s\n' "${1#*=}" >>"$filter_file"; shift ;;
        +*|-+*) printf '%s\n' "$1" >>"$filter_file"; shift ;;
        --)
            shift
            while [ "$#" -gt 0 ]; do printf '%s\n' "$1" >>"$filter_file"; shift; done
            ;;
        -*) err "unknown option [$1] (use -f '$1' for a tsk filter)" ;;
        *) append_query "$1"; shift ;;
    esac
done

export TSK_FZF_FILTER_FILE=$filter_file
TSK_FZF_SELF=$0
export TSK_FZF_SELF

tab=$(printf '\t')
filters=$(paste -sd' ' "$filter_file" 2>/dev/null)
header='enter list | tab select | C-e edit | C-a add | C-d done | M-p preview'
[ -n "$filters" ] && header="$header\nfilters: $filters"

entries=$(list_tasks) || exit $?
[ -n "$entries" ] || exit 71

selection=$(
    printf '%s\n' "$entries" |
        "$fzf_cmd" \
            --query "$query" \
            --multi \
            --delimiter "$tab" \
            --with-nth '2..' \
            --cycle \
            --history "$history_file" \
            --prompt 'tsk> ' \
            --header "$header" \
            --preview '"$TSK_FZF_SELF" __preview {1}' \
            --preview-window 'right:60%:wrap:hidden' \
            --bind 'ctrl-e:execute("$TSK_FZF_SELF" __edit {1})+reload("$TSK_FZF_SELF" __list)' \
            --bind 'ctrl-a:execute("$TSK_FZF_SELF" __add {q})+reload("$TSK_FZF_SELF" __list)' \
            --bind 'ctrl-d:execute("$TSK_FZF_SELF" __done {+1})+reload("$TSK_FZF_SELF" __list)' \
            --bind 'alt-p:toggle-preview'
) || exit $?

[ -n "$selection" ] || exit 71
ids=$(printf '%s\n' "$selection" | cut -f1)
printf '%s\n' "$ids" | tsk l
